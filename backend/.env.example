# Copy this file to ".env" and fill in the values. NEVER commit ".env".

# Google AI Studio key (https://aistudio.google.com/apikey) - stays on the server only
GEMMA_API_KEY=

# Default model and the list the frontend is allowed to pick from
GEMMA_MODEL=gemma-3-27b-it
ALLOWED_MODELS=gemma-3-27b-it,gemma-3-12b-it,gemma-3-4b-it

# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173

DATABASE_PATH=./gauvaani.db
